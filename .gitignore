# ============================================================
# Database / Liquibase (specific to your project)
# ============================================================

# Local database data
db/data/
postgres-data/
mysql-data/

# Liquibase logs and outputs
liquibase.log
liquibase-*.log
*-changes.sql
*-rollback.sql
prod-migration-plan.sql

# Local properties (may contain credentials)
liquibase.properties.local
liquibase.properties.personal
**/liquibase.properties.local

# But keep templates
!liquibase.properties.template
!liquibase.properties.*.template

# ============================================================
# CI/CD
# ============================================================

# Jenkins workspace
.jenkins/
jenkins-output/

# Test results
test-results/
test-reports/
coverage/

# ============================================================
# Miscellaneous
# ============================================================

# Archives (usually shouldn't be in repo)
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.bz2
*.xz
*.rar
*.7z

# Generated documentation outputs (HTML/PDF from AsciiDoc)
docs/build/
docs/output/
docs/generated/

# Local notes / scratch files
NOTES.md
TODO.local.md
SCRATCH.md
.notes/
scratch/

# History files
.history/
.bash_history
.zsh_history

# Editor recovery
*.rej
*.orig
