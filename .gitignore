# ============================================================
# Docker
# ============================================================

# Docker compose override files (local customizations)
docker-compose.override.yml
docker-compose.override.yaml
docker-compose.*.local.yml
docker-compose.*.local.yaml

# Docker environment files (may contain secrets)
.env
.env.*
!.env.example
!.env.template
!.env.sample

# Docker volumes data (when mounted to local paths)
docker-data/
.docker/
volumes/

# Docker build cache
.docker-cache/

# Container logs
*.log
logs/

# ============================================================
# AsciiDoc
# ============================================================

# Generated output
*.html
*.pdf
*.epub
*.mobi
*.docbook

# AsciiDoctor cache
.asciidoctor/

# Diagrams cache (asciidoctor-diagram)
.asciidoctor-diagram/

# Generated images from diagrams
images/diag-*.png
images/diag-*.svg

# But keep manually created images
!images/manual/

# AsciiDoc temp files
*.adoc.bak

# ============================================================
# Shell Scripts
# ============================================================

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Backup files
*.bak
*.backup
*.orig

# Script output files
output/
out/
results/

# Log files from scripts
*.log
*.log.*
script-*.log

# Exit code files
exit_code

# ============================================================
# Secrets and Credentials
# ============================================================

# Common secret files
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore
*.truststore

# Cloud credentials
gcp-credentials.json
gcp-key*.json
service-account*.json
.gcloud/
credentials/
secrets/

# SSH keys
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
known_hosts

# Password files
*passwords*
*credentials*
.netrc

# Environment-specific config with secrets
config.local.*
local.config

